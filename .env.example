# ==============================================================================
# App / Runtime
# ==============================================================================

# "development" | "production" | "test" - default: development
NODE_ENV=development

# Porta HTTP que o Nest escuta - default: 3000
PORT=3000

# ==============================================================================
# Database (Prisma / PostgreSQL)
# ==============================================================================

# String de conexão do Postgres. Em dev local via `npx prisma dev`, use a
# DATABASE_URL que o próprio comando imprime no terminal.
DATABASE_URL="postgresql://app:senha123@localhost:5432/consignado?schema=public"

# Tamanho do pool de conexões do Postgres - default: 10. Parâmetros de tuning
# na própria DATABASE_URL (connection_limit, pool_timeout etc.) NÃO fazem
# nada aqui - o driver adapter (@prisma/adapter-pg) usa node-postgres direto,
# que não reconhece esses parâmetros do antigo query-engine do Prisma. Ajuste
# em função de réplicas x conexões esperadas por réplica x max_connections do
# Postgres.
# DATABASE_POOL_SIZE=10

# ==============================================================================
# Queue & Cache (BullMQ + Cache / Redis)
# ==============================================================================

# Duas instâncias de Redis separadas, de propósito - nunca compartilham
# processo nem DB lógica. Um pico na fila de e-mail não deve competir por
# CPU/memória com o contador de lockout de login (dado de segurança), e uma
# instância separada pode futuramente ligar Redis Cluster Mode sem afetar a
# outra (o protocolo de cluster só expõe a DB 0 - dividir por DB lógica não
# seria uma opção nesse caso).
# BullMQ (filas, ex: notificações assíncronas):
# Local via Docker: docker compose up -d redis-queue
REDIS_URL="redis://localhost:6379"

# Cache de leitura, rate-limit e contador de lockout de login (ver
# ICache/CacheModule):
# Local via Docker: docker compose up -d redis-cache
CACHE_REDIS_URL="redis://localhost:6380"

# ==============================================================================
# Auth (JWT)
# ==============================================================================

# Segredo usado pra assinar/validar o access token JWT. Mínimo 32 caracteres
# (validado no boot - a aplicação não sobe sem isso). Gere um valor forte e
# aleatório por ambiente, nunca reaproveite entre dev/staging/produção.
JWT_SECRET="troque-por-um-secret-forte-de-pelo-menos-32-caracteres"

# ==============================================================================
# CORS (front-end)
# ==============================================================================

# Origem(ns) do front-end autorizadas a chamar a API, separadas por vírgula
# (ex: "https://app.com,https://admin.app.com"). Sem isso, cai no fallback
# "*" - e o refresh token (cookie httpOnly) não funciona: o navegador rejeita
# Access-Control-Allow-Origin: * combinado com credentials: true. Obrigatória
# sempre que o front estiver numa origem diferente da API.
CORS_ORIGIN="http://localhost:5173"

# ==============================================================================
# Reverse proxy / load balancer
# ==============================================================================

# Quantos "hops" de reverse proxy existem entre o cliente real e esse
# processo (ex: 1 pra um único load balancer/ingress na frente). Sem isso,
# req.ip fica com o socket real (correto pra acesso direto/local) - e é
# justamente req.ip que o rate limiting usa pra identificar cliente.
# Configure isso ao rodar atrás de proxy, senão todo cliente cai no mesmo
# balde de rate limit. NÃO configure isso sem ter um proxy de fato na frente:
# vira o problema oposto (cliente falsifica X-Forwarded-For pra escapar do
# throttle).
# TRUST_PROXY_HOPS=1

# ==============================================================================
# Observabilidade (Sentry - erros + tracing)
# ==============================================================================

# DSN do Sentry. Opcional: sem ela, Sentry.init() nem roda - captura de erro
# e tracing ficam simplesmente inativos, sem precisar de nenhuma infra extra.
# Aceita tanto o sentry.io (free tier já é suficiente) quanto um DSN de
# instância própria compatível (ex: GlitchTip - mas repare que o GlitchTip
# cobre só error tracking, não o Performance/Tracing do Sentry; pra ter as
# duas coisas self-hosted, seria o Sentry self-hosted mesmo, não o GlitchTip).
# SENTRY_DSN="https://exemplo@o0.ingest.sentry.io/0"

# ==============================================================================
# Armazenamento de arquivos (S3 - opcional)
# ==============================================================================

# Só necessário se você trocar o binding de FILE_STORAGE em
# file-asset.module.ts de LocalFileStorage para S3FileStorage (ver README >
# Ports & adapters). Credenciais NÃO vão aqui - a SDK da AWS resolve pela
# cadeia padrão (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, IAM role em
# produção, etc), nunca passadas explicitamente no código.
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="meu-bucket"

# ==============================================================================
# E-mail (Resend - opcional)
# ==============================================================================

# Só necessário se você trocar o binding de EMAIL_SENDER em email.module.ts
# de LogEmailSender para ResendEmailSender (ver README > Ports & adapters).
# EMAIL_FROM precisa ser um remetente verificado no domínio configurado na
# Resend.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# EMAIL_FROM="onboarding@seu-dominio.com"
